# Server environment variables — copy to `.env` and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# MongoDB connection string
MONGODB_URI=

# Gmail (or other SMTP) account used to send newsletters / contact emails.
# For Gmail use an App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=

# Optional: address that /send-email delivers to (defaults to EMAIL_USER).
EMAIL_TO=

# Port the API listens on (defaults to 3000).
PORT=3000
